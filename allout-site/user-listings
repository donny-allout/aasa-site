<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Seller Listings — ALLOUT</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root {
  --orange: #E8780A; --orange-dim: rgba(232,120,10,0.12);
  --bg: #0a0a0a; --surface: #111; --surface2: #161616;
  --border: #1f1f1f; --text: #e8e8e8; --muted: #666; --white: #fff;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; font-weight: 300; min-height: 100vh; }

/* NAV */
nav { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px;
  border-bottom: 1px solid var(--border); position: sticky; top: 0;
  background: rgba(10,10,10,0.94); backdrop-filter: blur(12px); z-index: 10; }
.nav-left { display: flex; align-items: center; gap: 10px; }
.logo { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 0.18em; color: var(--white); text-decoration: none; }
.logo-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); }
.nav-links { display: flex; gap: 22px; align-items: center; }
.nav-links a { font-size: 13px; color: var(--muted); text-decoration: none; transition: color .2s; }
.nav-links a:hover { color: var(--white); }
.nav-cta { font-size: 13px; color: var(--white); background: var(--orange); padding: 8px 18px; border-radius: 8px; text-decoration: none; font-weight: 500; transition: opacity .2s; }
.nav-cta:hover { opacity: 0.88; }

/* PROFILE HEADER */
.profile-header { max-width: 1100px; margin: 0 auto; padding: 40px 24px 32px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.profile-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; background: var(--surface2); flex-shrink: 0; border: 2px solid var(--border); }
.profile-avatar-placeholder { width: 80px; height: 80px; border-radius: 50%; background: var(--surface2); flex-shrink: 0; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 32px; }
.profile-info h1 { font-family: 'Bebas Neue', cursive; font-size: 36px; letter-spacing: 0.08em; color: var(--white); line-height: 1; margin-bottom: 4px; }
.profile-info p { font-size: 13px; color: var(--muted); }
.profile-stats { display: flex; gap: 24px; margin-top: 12px; }
.stat { text-align: center; }
.stat-num { font-family: 'Bebas Neue', cursive; font-size: 24px; color: var(--orange); letter-spacing: 0.04em; }
.stat-label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
.msg-seller-btn { display: inline-flex; align-items: center; gap: 8px; background: var(--orange); color: #fff; padding: 11px 22px; border-radius: 10px; font-size: 14px; font-weight: 500; text-decoration: none; transition: opacity .2s; margin-top: 12px; }
.msg-seller-btn:hover { opacity: 0.88; }

/* LISTINGS */
.listings-section { max-width: 1100px; margin: 0 auto; padding: 0 24px 80px; }
.section-title { font-family: 'DM Mono', monospace; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
.listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }

/* CARD */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-decoration: none; display: block; transition: border-color .2s, transform .15s; }
.card:hover { border-color: #2a2a2a; transform: translateY(-2px); }
.card-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; background: var(--surface2); display: block; }
.card-img-placeholder { width: 100%; aspect-ratio: 4/3; background: var(--surface2); display: flex; align-items: center; justify-content: center; font-size: 32px; color: var(--muted); }
.card-body { padding: 14px; }
.card-price { font-family: 'Bebas Neue', cursive; font-size: 22px; letter-spacing: 0.04em; color: var(--orange); margin-bottom: 4px; }
.card-title { font-size: 14px; font-weight: 500; color: var(--white); margin-bottom: 4px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-meta { font-size: 12px; color: var(--muted); }
.card-ffl { display: inline-block; font-size: 10px; font-weight: 600; color: var(--orange); background: var(--orange-dim); border: 1px solid rgba(232,120,10,0.2); border-radius: 4px; padding: 2px 7px; margin-top: 6px; }

/* STATES */
.state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 40vh; gap: 14px; color: var(--muted); font-size: 14px; text-align: center; padding: 40px; }
.state-icon { font-size: 40px; opacity: 0.3; }
.spinner { width: 32px; height: 32px; border: 2px solid var(--border); border-top-color: var(--orange); border-radius: 50%; animation: spin 0.9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

footer { border-top: 1px solid var(--border); padding: 28px 24px; max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 12px; color: var(--muted); }
footer a { color: var(--muted); text-decoration: none; }
footer a:hover { color: var(--white); }

@media (max-width: 640px) {
  nav { padding: 14px 20px; }
  .nav-links { display: none; }
  .profile-header { padding: 28px 16px 20px; }
  .listings-section { padding: 0 16px 60px; }
}
</style>
</head>
<body>

<nav>
  <div class="nav-left">
    <a href="/" class="logo">ALLOUT</a>
    <div class="logo-dot"></div>
  </div>
  <div class="nav-links">
    <a href="/">Home</a>
    <a href="/firearms">Firearms</a>
    <a href="/my-listings">My Listings</a>
    <a href="/messages">Messages</a>
    <a href="/legal">Legal</a>
  </div>
  <a href="/app" class="nav-cta">Download App</a>
</nav>

<!-- PROFILE HEADER -->
<div class="profile-header" id="profile-header" style="display:none">
  <div id="avatar-placeholder" class="profile-avatar-placeholder">👤</div>
  <img id="avatar-img" class="profile-avatar" style="display:none" alt="Profile photo">
  <div class="profile-info">
    <h1 id="profile-name">—</h1>
    <p id="profile-sub">Seller on Allout</p>
    <div class="profile-stats">
      <div class="stat">
        <div class="stat-num" id="stat-listings">0</div>
        <div class="stat-label">Listings</div>
      </div>
    </div>
    <a id="msg-btn" href="#" class="msg-seller-btn">💬 Message Seller</a>
  </div>
</div>

<!-- LISTINGS -->
<div class="listings-section">
  <div id="loading" class="state"><div class="spinner"></div><span>Loading listings…</span></div>
  <div id="error" class="state" style="display:none"><div class="state-icon">⚠️</div><span id="error-msg">User not found.</span></div>
  <div id="empty" class="state" style="display:none"><div class="state-icon">🔫</div><span>No active listings from this seller.</span></div>
  <div id="listings-wrap" style="display:none">
    <div class="section-title" id="section-title">Active Listings</div>
    <div class="listings-grid" id="listings-grid"></div>
  </div>
</div>

<footer>
  <span>© 2026 Fieldstream LLC</span>
  <div style="display:flex;gap:20px;">
    <a href="/firearms">Browse Firearms</a>
    <a href="/legal">Terms & Privacy</a>
    <a href="mailto:Support@alloutdoors.co">Contact</a>
  </div>
</footer>

<script>
const SUPABASE_URL = 'https://tnvhrmabgmlwehvfljmu.supabase.co';
const SUPABASE_ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRudmhybWFiZ21sd2VodmZsam11Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjI5MDY5MjAsImV4cCI6MjA3ODQ4MjkyMH0.5aHVV-kI8dMFJ4cH2ydjkOnz4j9JNqPTrpK8NOUGdo4';
const STORAGE_BASE = `${SUPABASE_URL}/storage/v1/object/public/marketplace`;
const AVATAR_BASE = `${SUPABASE_URL}/storage/v1/object/public/profile_pictures`;
const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON);

function show(id) { document.getElementById(id).style.display = ''; }
function hide(id) { document.getElementById(id).style.display = 'none'; }
function block(id) { document.getElementById(id).style.display = 'block'; }
function text(id, v) { document.getElementById(id).textContent = v; }

async function load() {
  const params = new URLSearchParams(window.location.search);
  const uid = params.get('uid');

  if (!uid) {
    hide('loading'); show('error'); text('error-msg', 'No user specified.'); return;
  }

  try {
    // Fetch profile
    const { data: profile, error: profileErr } = await sb
      .from('profiles')
      .select('full_name, username, avatar_url, id')
      .eq('id', uid)
      .single();

    if (profileErr || !profile) throw new Error('User not found.');

    // Show profile header
    const displayName = profile.full_name || profile.username || 'Allout Member';
    text('profile-name', displayName);
    document.title = `${displayName} — ALLOUT`;

    if (profile.avatar_url) {
      const avatarSrc = profile.avatar_url.startsWith('http')
        ? profile.avatar_url
        : `${AVATAR_BASE}/${profile.avatar_url}`;
      const avatarImg = document.getElementById('avatar-img');
      avatarImg.src = avatarSrc;
      avatarImg.style.display = 'block';
      hide('avatar-placeholder');
    }

    // Message seller button — links to messages with this user's listing
    // We link to /messages and let the user pick a listing to contact them about
    // If they came from a listing page, we could pass that through — for now go to firearms browse
    document.getElementById('msg-btn').href = `/firearms`;
    document.getElementById('msg-btn').textContent = '🔫 Browse Their Listings';

    show('profile-header');

    // Fetch their active listings
    const { data: listings, error: listingsErr } = await sb
      .from('marketplace_listings')
      .select('listing_id, title, price_cents, location_city, location_state, firearm_requires_ffl, thumbnail_path, listing_type, condition, created_at')
      .eq('owner_id', uid)
      .eq('status', 'active')
      .order('created_at', { ascending: false });

    if (listingsErr) throw new Error('Could not load listings.');

    hide('loading');
    text('stat-listings', listings ? listings.length : 0);

    if (!listings || listings.length === 0) {
      show('empty'); return;
    }

    text('section-title', `${listings.length} Active Listing${listings.length !== 1 ? 's' : ''}`);
    const grid = document.getElementById('listings-grid');

    listings.forEach(l => {
      const thumbURL = l.thumbnail_path ? `${STORAGE_BASE}/${l.thumbnail_path}` : null;
      const price = l.price_cents ? '$' + (l.price_cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2 }) : 'Price on request';
      const loc = [l.location_city, l.location_state].filter(Boolean).join(', ');

      const card = document.createElement('a');
      card.className = 'card';
      card.href = `/listing/${l.listing_id}`;

      card.innerHTML = thumbURL
        ? `<img class="card-img" src="${thumbURL}" alt="${l.title}" loading="lazy" onerror="this.outerHTML='<div class=\\'card-img-placeholder\\'>🔫</div>'">`
        : `<div class="card-img-placeholder">🔫</div>`;

      card.innerHTML += `<div class="card-body">
        <div class="card-price">${price}</div>
        <div class="card-title">${l.title || 'Untitled'}</div>
        ${loc ? `<div class="card-meta">📍 ${loc}</div>` : ''}
        ${l.firearm_requires_ffl ? '<span class="card-ffl">FFL Required</span>' : ''}
      </div>`;

      grid.appendChild(card);
    });

    show('listings-wrap');

  } catch (err) {
    hide('loading'); show('error'); text('error-msg', err.message || 'Something went wrong.');
    console.error(err);
  }
}

load();
</script>
</body>
</html>
