{
  "routes": [
    {
      "src": "/.well-known/apple-app-site-association",
      "dest": "/.well-known/apple-app-site-association",
      "headers": { "Content-Type": "application/json" }
    },
    {
      "src": "/.well-known/(.*)",
      "dest": "/.well-known/$1"
    },
    {
      "src": "/app",
      "dest": "/allout-site/app.html"
    },
    {
      "src": "/firearms",
      "dest": "/allout-site/firearms.html"
    },
    {
      "src": "/create-listing",
      "dest": "/allout-site/create-listing.html"
    },
    {
      "src": "/my-listings",
      "dest": "/allout-site/my-listings.html"
    },
    {
      "src": "/messages",
      "dest": "/allout-site/messages.html"
    },
    {
      "src": "/user-listings(.*)",
      "dest": "/allout-site/user-listings.html"
    },
    {
      "src": "/legal",
      "dest": "/allout-site/legal.html"
    },
    {
      "src": "/listing/([a-f0-9-]+)",
      "dest": "/allout-site/listing.html?id=$1"
    },
    {
      "src": "/post/(.*)",
      "dest": "/allout-site/redirect.html"
    },
    {
      "src": "/reel/(.*)",
      "dest": "/allout-site/redirect.html"
    },
    {
      "src": "/trophy/(.*)",
      "dest": "/allout-site/redirect.html"
    },
    {
      "src": "/u/(.*)",
      "dest": "/allout-site/redirect.html"
    },
    {
      "src": "/(.*)",
      "dest": "/allout-site/$1"
    }
  ]
}
